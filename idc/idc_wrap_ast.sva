module edge_detect_fpv_wrap #(
    parameter int SYNC_NUM = 2
)(
    input  logic clk,
    input  logic rst_n,
    input  logic edge_in,
    input  logic async_edge,
    input  logic edge_stb,
    input  logic dft_dc_scan_clk,
    input  logic dft_dc_scan_mode,
    input  logic dft_dc_scan_rst_n
);

    edge_detect_fpv #(
        .SYNC_NUM(SYNC_NUM)
    ) u_edge_detect_fpv (
        .clk               (clk),
        .rst_n             (rst_n),
        .edge_in           (edge_in),
        .async_edge        (async_edge),
        .edge_stb          (edge_stb),
        .dft_dc_scan_clk   (dft_dc_scan_clk),
        .dft_dc_scan_mode  (dft_dc_scan_mode),
        .dft_dc_scan_rst_n (dft_dc_scan_rst_n)
    );

endmodule

module merge_checker #(
    parameter int BUS_WIDTH = 32
)(
    input  logic                 clk,
    input  logic                 rst_n,
    input  logic                 merge_to_ic,
    input  logic [BUS_WIDTH-1:0] group_in,
`ifdef REGBANK_CHECK_ENABLE
    input  logic [BUS_WIDTH-1:0] group_regbank_enable,
    input  logic [BUS_WIDTH-1:0] group_regbank_mask,
`endif
    input  logic [BUS_WIDTH-1:0] group_regbank_in,
    input  logic [BUS_WIDTH-1:0] group_regbank_out
);

    logic merge_regbank_bit;
    assign merge_regbank_bit = |group_regbank_out;

    // Connectivity check: group_in vs group_regbank_in
    conn_checker #(
        .WIDTH(BUS_WIDTH)
    ) u_conn_checker_group_in (
        .clk   (clk),
        .rst_n (rst_n),
        .in    (group_in),
        .out   (group_regbank_in)
    );

    // Connectivity check: merge_regbank_bit vs merge_to_ic
    conn_checker #(
        .WIDTH(1)
    ) u_conn_checker_merge (
        .clk   (clk),
        .rst_n (rst_n),
        .in    (merge_regbank_bit),
        .out   (merge_to_ic)
    );

endmodule

module conn_checker #(
    parameter int WIDTH = 32
)(
    input  logic             clk,
    input  logic             rst_n,
    input  logic [WIDTH-1:0] in,
    input  logic [WIDTH-1:0] out
);

    property p_eq;
        @(posedge clk) disable iff (!rst_n)
        in == out;
    endproperty

    ast_eq: assert property (p_eq);

    cov_in_changed:  cover property (@(posedge clk) $changed(in));
    cov_out_changed: cover property (@(posedge clk) $changed(out));

endmodule
